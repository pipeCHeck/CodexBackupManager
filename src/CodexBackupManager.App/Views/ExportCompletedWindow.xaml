<Window x:Class="CodexBackupManager.App.Views.ExportCompletedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="내보내기 완료" Width="640" Height="600" MinWidth="380" MinHeight="420"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
  <!-- Phase 9_6-01 — 내보내기 성공 직후 한 번 띄운다. 작업 폴더 목록만 스크롤하고, 좁은 폭에서는 버튼이 다음 줄로 넘어간다.
       [닫기]는 Esc(IsCancel)로도 닫힌다. -->
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="80" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 요약 -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="✅ 내보내기 완료" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="{Binding BackupFileText}" Margin="0,6,0,0" TextWrapping="Wrap" />
      <TextBlock Text="{Binding CountsText}" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <!-- 강조 안내 -->
    <Border Grid.Row="1" Background="{StaticResource WarnBg}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
      <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                 AutomationProperties.Name="{Binding Notice}" />
    </Border>

    <TextBlock Grid.Row="2" Text="옮겨야 할 작업 폴더" FontWeight="SemiBold" Margin="0,14,0,6" />

    <!-- 작업 폴더 목록(이 영역만 스크롤) -->
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
      <ScrollViewer x:Name="FolderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="True" AutomationProperties.Name="옮겨야 할 작업 폴더 목록">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="12,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4,0,8">
                <TextBlock TextWrapping="Wrap">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                  <Run Text=" · " Foreground="{StaticResource Muted}" />
                  <Run Text="{Binding ConversationCountText, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Folders}" Margin="14,2,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Consolas, D2Coding, Malgun Gothic" FontSize="12"
                                 Margin="0,1,0,1">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="작업 폴더 정보가 백업에 없습니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="14,2,0,0"
                           Visibility="{Binding HasNoFolders, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="4" Text="{Binding Tip}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />

    <!-- 버튼 + 저장 안내 -->
    <StackPanel Grid.Row="5" Margin="0,12,0,0">
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="목록을 텍스트 파일로 저장…" Command="{Binding SaveTextCommand}" Margin="0,0,8,4" Padding="12,5" />
        <Button Content="닫기" Command="{Binding CloseCommand}" IsCancel="True" IsDefault="True" Margin="0,0,0,4" Padding="12,5" MinWidth="72" />
      </WrapPanel>
      <TextBlock Text="{Binding TextFileNote}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Right"
                 TextAlignment="Right" />
      <TextBlock Text="{Binding SaveStatusText}" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,4,0,0"
                 AutomationProperties.LiveSetting="Polite"
                 Visibility="{Binding SaveStatusText, Converter={StaticResource NullToCollapsed}}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Ok}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSaveError}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Bad}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </Grid>
</Window>
