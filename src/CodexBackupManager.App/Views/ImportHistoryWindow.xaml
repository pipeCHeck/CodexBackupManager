<Window x:Class="CodexBackupManager.App.Views.ImportHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="가져오기 기록" Width="860" Height="640" MinWidth="520" MinHeight="460"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
  <!-- Phase 9_4-02 — 현재 Codex Home의 기록만(최신순). [되돌리기]·[선택 삭제]·[정리]는 확인을 받은 뒤에만 쓴다. -->
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="가져오기 기록" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <ListBox x:Name="HistoryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="가져오기 기록 목록">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="8,5" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <WrapPanel>
                  <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding KindText}" Foreground="{StaticResource Info}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding ResultText}" Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding BackupText}" TextTrimming="CharacterEllipsis" />
                </WrapPanel>
                <TextBlock Text="{Binding CountsText}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                           Visibility="{Binding CountsText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding AvailabilityText}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="이 Codex 폴더의 가져오기 기록이 없습니다." Foreground="{StaticResource Muted}" Margin="12"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <!-- 고른 기록의 상세 -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="6" Padding="12,10" Margin="0,10,0,0" MaxHeight="200">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap"
                     Visibility="{Binding DetailText, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Text="대상 대화" FontWeight="SemiBold" Margin="0,8,0,2" />
          <ItemsControl ItemsSource="{Binding DetailConversations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,0,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="새로 만든 프로젝트" FontWeight="SemiBold" Margin="0,8,0,2" />
          <ItemsControl ItemsSource="{Binding DetailProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,0,0,0" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <WrapPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right">
      <Button Content="되돌리기" Command="{Binding UndoCommand}" Margin="0,0,8,4" Padding="12,5" />
      <Button Content="선택 삭제" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,4" Padding="12,5" />
      <Button Content="30일 지난 기록 정리" Command="{Binding CleanupCommand}" Margin="0,0,8,4" Padding="12,5" />
      <Button Content="닫기" Command="{Binding CloseCommand}" IsCancel="True" Margin="0,0,0,4" Padding="12,5" MinWidth="72" />
    </WrapPanel>

    <TextBlock Grid.Row="4" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"
               Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
  </Grid>
</Window>
