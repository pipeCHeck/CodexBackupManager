<Window x:Class="CodexBackupManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:render="clr-namespace:CodexBackupManager.App.Rendering"
        Title="Codex Backup Manager" Height="760" Width="1100"
        MinHeight="560" MinWidth="820"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 제목 + 상태 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="Codex Backup Manager" FontSize="21" FontWeight="SemiBold" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusGlyph}" FontSize="17" Margin="0,0,7,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Foreground" Value="{StaticResource Bad}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Ok}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding StatusText}" FontSize="14" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Codex Home 경로 -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6"
            Padding="14,11" Margin="0,16,0,0"
            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="Codex Home" Foreground="{StaticResource Muted}" FontSize="11" />
        <TextBlock Text="{Binding HomePath}" FontFamily="Consolas, D2Coding, Malgun Gothic"
                   FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- 경고 / 실패 사유 -->
    <Border Grid.Row="2" Background="#FF3A2E1E" CornerRadius="6" Padding="14,11" Margin="0,14,0,0"
            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
    </Border>

    <!-- 본문. 위쪽 진단 영역은 필요한 만큼만(Auto) 차지하고, 남는 세로 공간은 전부 프로젝트/
         Conversation Viewer 영역(Height="*")이 가져간다 — 진단 영역이 펼쳐져도 아래 §4.1
         Border의 MaxHeight로 막혀 있어 창 전체를 다시 잡아먹지 않는다(Phase 04_07). -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 탐지 실패 안내 -->
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="16"
              VerticalAlignment="Top">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="Codex 데이터 폴더를 직접 선택해 주세요."
                     FontSize="14" Margin="0,0,0,10" />
          <TextBlock Text="후보 경로 검사 결과" Foreground="{StaticResource Muted}"
                     FontSize="11" Margin="0,0,0,5" />
          <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- 탐지 성공 정보(Phase 1, Phase 04_07에서 Compact/Expand로 재구성). 진단 정보는 평소에
           계속 봐야 하는 게 아니라 문제 생겼을 때만 보는 정보라, 기본은 접힌 상태(요구사항)다.
           접힌 기본 상태에서는 Desktop/CLI/Sessions/Threads 요약 한 줄만 보이고, "상세 정보"를
           누르면 기존 State DB/Migration/Archived/탐색 후보 전체가 펼쳐진다. 다시 누르면 접힌다.
           연결 실패 안내(위 Border)와 경고(WarningText, Grid.Row="2")는 이 구조와 무관하게 계속
           그대로 보인다 — 접어도 숨겨지지 않는다. -->
      <Grid Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 접힌 상태에서도 항상 보이는 한 줄 요약 + 상세 정보 토글. -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding CompactSummaryText}"
                     Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <ToggleButton x:Name="DetailToggle" Grid.Column="1" Style="{StaticResource DetailToggleLink}"
                        VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>

        <!-- 상세 정보(기본 접힘). MaxHeight로 창 전체를 다시 잡아먹지 않게 막고, 그 안에서만
             스크롤한다 — 창을 세로로 늘려도 이 영역이 아니라 프로젝트/Viewer 영역이 남는 공간을
             가져간다. -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6" Padding="14"
                Margin="0,8,0,0" MaxHeight="260"
                Visibility="{Binding IsChecked, ElementName=DetailToggle, Converter={StaticResource BoolToVisibility}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,7">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="215" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                 FontFamily="Consolas, D2Coding, Malgun Gothic" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="탐색 후보 기록" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,16,0,6" />
              <ItemsControl ItemsSource="{Binding ProbeRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="215" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                 Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 프로젝트 / 대화 카탈로그 (Phase 2) + 대화 내용 placeholder (Phase 3 예정) -->
      <Grid Grid.Row="1" Margin="0,14,0,0"
            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" MinWidth="260" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 프로젝트 → 대화 트리. 이름이 잘리지 않도록 전보다 훨씬 넓게 기본 배치하고,
             GridSplitter로 사용자가 폭을 더 조절할 수 있게 한다. -->
        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding CatalogSummaryText, TargetNullValue='카탈로그 준비 중…'}"
                       Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Text="목록을 만드는 중입니다…"
                       Foreground="{StaticResource Muted}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Focusable="False": 체크박스가 키보드 포커스를 받으면 TreeViewItem이 그걸 "선택"으로
                 취급해 오른쪽 Viewer가 바뀐다(WPF의 "포커스가 선택을 따라간다" 동작). 체크(백업 선택)와
                 Viewer 포커스를 완전히 분리하기 위해 체크박스는 포커스를 받지 않게 한다.
                 헤더/제목을 Grid(Auto+*)로 감싸는 이유: StackPanel은 자식에게 무한 너비를 주기 때문에
                 TextTrimming이 실제로 동작하지 않는다 — 폭을 실제로 제한해야 말줄임이 걸린다. -->
            <TreeView x:Name="ConversationTree" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding ProjectNodes}"
                      SelectedItemChanged="ConversationTree_SelectedItemChanged">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="True" />
                  <Setter Property="Padding" Value="0,3" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Conversations}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsThreeState="True" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Focusable="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="{Binding HeaderText}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding HeaderText}" />
                  </Grid>
                  <HierarchicalDataTemplate.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Focusable="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                      </Grid>
                    </DataTemplate>
                  </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <!-- 선택 요약 + 전체 선택/해제(Phase 4) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="{Binding SelectionSummaryText}" Foreground="{StaticResource Muted}"
                         FontSize="11" VerticalAlignment="Center" />
              <Button Content="전체 선택" Command="{Binding SelectAllConversationsCommand}"
                      Margin="10,0,0,0" Padding="8,3" MinWidth="0" FontSize="11" />
              <Button Content="선택 해제" Command="{Binding ClearSelectionCommand}"
                      Margin="6,0,0,0" Padding="8,3" MinWidth="0" FontSize="11" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 사용자가 폭을 조절할 수 있는 splitter. -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="Transparent" Margin="4,0" Cursor="SizeWE" />

        <!-- 오른쪽: 대화 내용(Conversation Viewer, Phase 3) -->
        <Grid Grid.Column="2" Margin="0">

          <!-- 아직 대화를 선택하지 않았을 때 -->
          <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14"
                  Visibility="{Binding NoConversationSelected, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="대화 내용" Foreground="{StaticResource Muted}"
                         FontSize="13" HorizontalAlignment="Center" />
              <TextBlock Text="왼쪽에서 대화를 선택하세요." Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- 대화를 선택했을 때: 제목 + 로딩/오류 + 메시지 목록 -->
          <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14"
                  Visibility="{Binding HasSelectedConversation, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock Text="{Binding SelectedConversationTitle}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="읽는 중…" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding IsConversationLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ConversationErrorText}" Foreground="{StaticResource Bad}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasConversationError, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <!-- ListBox는 기본적으로 VirtualizingStackPanel을 쓰므로 메시지가 수백/수천 개여도
                   화면에 보이는 만큼만 UI 요소를 만든다(요구사항 10).
                   VirtualizingPanel.ScrollUnit="Pixel": 기본값(Item)은 마우스 휠 한 번에 "메시지
                   한 칸"(=여러 줄짜리 말풍선 하나) 단위로 건너뛰어 스크롤이 딱딱하고 한 번에 너무
                   많이 움직인다. Pixel 단위로 바꾸면 가상화(성능)는 그대로 유지하면서 일반 문서처럼
                   부드럽게 스크롤된다. -->
              <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding ConversationMessages}"
                       BorderThickness="0" Background="Transparent"
                       ScrollViewer.CanContentScroll="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       VirtualizingPanel.ScrollUnit="Pixel"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,16" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <!-- Codex 실제 UI에 가깝게: Assistant는 완전 평면도, 무거운 채팅 말풍선도 아닌
                     "은은한 문서 카드"로 표시한다(PanelAlt 배경, 약한 CornerRadius, Border 없음) —
                     본문 폭은 넉넉히 유지해 문서형 읽기 느낌을 지킨다. User는 오른쪽 정렬의 작은
                     말풍선(내용 크기만큼만)으로 남기되, 창 오른쪽 벽에 완전히 붙지 않도록 오른쪽
                     여백을 둔다. Role/Phase 라벨(User/Assistant/commentary/final)은 개발자 도구처럼
                     보인다는 지적을 반영해 전부 제거했다 — 정렬/배경색만으로 구분한다. Phase 값 자체는
                     Domain에 그대로 보존되고(향후 Export 등에서 쓸 수 있다), UI에만 안 보여준다. -->
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Bubble">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="HorizontalAlignment" Value="Left" />
                          <Setter Property="Background" Value="{StaticResource PanelAlt}" />
                          <Setter Property="CornerRadius" Value="9" />
                          <Setter Property="Padding" Value="16,14" />
                          <Setter Property="Margin" Value="0" />
                          <Setter Property="MaxWidth" Value="760" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                              <Setter Property="HorizontalAlignment" Value="Right" />
                              <Setter Property="Background" Value="{StaticResource UserBubbleBg}" />
                              <Setter Property="CornerRadius" Value="14" />
                              <Setter Property="Padding" Value="14,9" />
                              <Setter Property="Margin" Value="0,2,24,2" />
                              <Setter Property="MaxWidth" Value="520" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <!-- 읽기 전용 RichTextBox: Markdown-lite로 파싱한 FlowDocument(제목/문단/
                           목록/코드블록 서식)를 붙인다. 일반 TextBlock과 달리 텍스트 선택/복사는
                           그대로 유지된다. RichTextBox.Document는 일반 CLR 속성이라 직접 바인딩할
                           수 없어 render:FlowDocumentBinding.Document 첨부 속성을 거친다. -->
                      <RichTextBox render:FlowDocumentBinding.Document="{Binding Body}"
                                   IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                   Foreground="{StaticResource Fg}" IsReadOnlyCaretVisible="False"
                                   Cursor="IBeam" Padding="0"
                                   HorizontalScrollBarVisibility="Disabled" />
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- 하단 버튼 -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
      <Button Content="Codex 폴더 선택" Command="{Binding ChangeFolderCommand}" />
      <Button Content="다시 확인" Command="{Binding RefreshCommand}" />
      <TextBlock Text="Codex 원본 데이터는 읽기 전용으로만 접근합니다."
                 Foreground="{StaticResource Muted}" FontSize="11"
                 VerticalAlignment="Center" Margin="10,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
