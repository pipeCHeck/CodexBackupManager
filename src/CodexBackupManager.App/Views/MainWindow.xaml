<Window x:Class="CodexBackupManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Backup Manager" Height="720" Width="900"
        MinHeight="520" MinWidth="720"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 제목 + 상태 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="Codex Backup Manager" FontSize="21" FontWeight="SemiBold" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusGlyph}" FontSize="17" Margin="0,0,7,0">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
              <Setter Property="Foreground" Value="{StaticResource Bad}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Ok}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding StatusText}" FontSize="14" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Codex Home 경로 -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="6"
            Padding="14,11" Margin="0,16,0,0"
            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="Codex Home" Foreground="{StaticResource Muted}" FontSize="11" />
        <TextBlock Text="{Binding HomePath}" FontFamily="Consolas, D2Coding, Malgun Gothic"
                   FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- 경고 / 실패 사유 -->
    <Border Grid.Row="2" Background="#FF3A2E1E" CornerRadius="6" Padding="14,11" Margin="0,12,0,0"
            Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding WarningText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
    </Border>

    <!-- 본문 -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="220" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 탐지 실패 안내 -->
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="16"
              VerticalAlignment="Top">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="Codex 데이터 폴더를 직접 선택해 주세요."
                     FontSize="14" Margin="0,0,0,10" />
          <TextBlock Text="후보 경로 검사 결과" Foreground="{StaticResource Muted}"
                     FontSize="11" Margin="0,0,0,5" />
          <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- 탐지 성공 정보 (Phase 1) -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                             FontFamily="Consolas, D2Coding, Malgun Gothic" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="탐색 후보 기록" Foreground="{StaticResource Muted}"
                     FontSize="11" Margin="0,16,0,6" />
          <ItemsControl ItemsSource="{Binding ProbeRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- 프로젝트 / 대화 카탈로그 (Phase 2) + 대화 내용 placeholder (Phase 3 예정) -->
      <Grid Grid.Row="1" Margin="0,12,0,0"
            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 프로젝트 → 대화 트리 -->
        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding CatalogSummaryText, TargetNullValue='카탈로그 준비 중…'}"
                       Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Text="목록을 만드는 중입니다…"
                       Foreground="{StaticResource Muted}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsCatalogLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Focusable="False": 체크박스가 키보드 포커스를 받으면 TreeViewItem이 그걸 "선택"으로
                 취급해 오른쪽 Viewer가 바뀐다(WPF의 "포커스가 선택을 따라간다" 동작). 체크(백업 선택)와
                 Viewer 포커스를 완전히 분리하기 위해 체크박스는 포커스를 받지 않게 한다. -->
            <TreeView x:Name="ConversationTree" Grid.Row="1" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding ProjectNodes}"
                      SelectedItemChanged="ConversationTree_SelectedItemChanged">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="True" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Conversations}">
                  <StackPanel Orientation="Horizontal">
                    <CheckBox IsThreeState="True" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Focusable="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" />
                  </StackPanel>
                  <HierarchicalDataTemplate.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Focusable="False" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DataTemplate>
                  </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <!-- 선택 요약 + 전체 선택/해제(Phase 4) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="{Binding SelectionSummaryText}" Foreground="{StaticResource Muted}"
                         FontSize="11" VerticalAlignment="Center" />
              <Button Content="전체 선택" Command="{Binding SelectAllConversationsCommand}"
                      Margin="10,0,0,0" Padding="8,3" MinWidth="0" FontSize="11" />
              <Button Content="선택 해제" Command="{Binding ClearSelectionCommand}"
                      Margin="6,0,0,0" Padding="8,3" MinWidth="0" FontSize="11" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 오른쪽: 대화 내용(Conversation Viewer, Phase 3) -->
        <Grid Grid.Column="1" Margin="12,0,0,0">

          <!-- 아직 대화를 선택하지 않았을 때 -->
          <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14"
                  Visibility="{Binding NoConversationSelected, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="대화 내용" Foreground="{StaticResource Muted}"
                         FontSize="13" HorizontalAlignment="Center" />
              <TextBlock Text="왼쪽에서 대화를 선택하세요." Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- 대화를 선택했을 때: 제목 + 로딩/오류 + 메시지 목록 -->
          <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14"
                  Visibility="{Binding HasSelectedConversation, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock Text="{Binding SelectedConversationTitle}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="읽는 중…" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding IsConversationLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding ConversationErrorText}" Foreground="{StaticResource Bad}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasConversationError, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <!-- ListBox는 기본적으로 VirtualizingStackPanel을 쓰므로 메시지가 수백/수천 개여도
                   화면에 보이는 만큼만 UI 요소를 만든다(요구사항 10). -->
              <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding ConversationMessages}"
                       BorderThickness="0" Background="Transparent"
                       ScrollViewer.CanContentScroll="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="10,8" MaxWidth="640">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="HorizontalAlignment" Value="Left" />
                          <Setter Property="Background" Value="{StaticResource Bg}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                              <Setter Property="HorizontalAlignment" Value="Right" />
                              <Setter Property="Background" Value="#FF2F3B4C" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" FontSize="11"
                                     Foreground="{StaticResource Muted}" />
                          <TextBlock Text="{Binding PhaseLabel}" FontSize="10" Margin="6,0,0,0"
                                     Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <!-- 읽기 전용 TextBox: 줄바꿈을 그대로 보존하면서 텍스트 선택/복사를 지원한다. -->
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True"
                                 IsReadOnlyCaretVisible="False" Cursor="IBeam" Margin="0,4,0,0"
                                 IsHitTestVisible="True" Focusable="True" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- 하단 버튼 -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="Codex 폴더 선택" Command="{Binding ChangeFolderCommand}" />
      <Button Content="다시 확인" Command="{Binding RefreshCommand}" />
      <TextBlock Text="Codex 원본 데이터는 읽기 전용으로만 접근합니다."
                 Foreground="{StaticResource Muted}" FontSize="11"
                 VerticalAlignment="Center" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
