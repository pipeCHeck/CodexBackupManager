<UserControl x:Class="CodexBackupManager.App.Views.ImportWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CodexBackupManager.App.Views"
             x:Name="Root">
  <!-- Phase 9_2-2 가져오기 작업 공간(설계 §7). DataContext = ImportWorkspaceViewModel.
       상태별 영역은 ViewModel의 IsWaitingForCodexExit / IsAnalyzing / IsFailed / IsEditorVisible / IsApplying / IsResult로 전환한다.
       이 View는 상태를 들고 있지 않는다(트리 선택만 SelectNode로 넘긴다). -->
  <UserControl.Resources>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="PathText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="Consolas, D2Coding, Malgun Gothic" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 배지(설계 §7.4 색) -->
    <Style x:Key="BadgeBorder" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Muted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="New">
          <Setter Property="BorderBrush" Value="{StaticResource Ok}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="IncomingAhead">
          <Setter Property="BorderBrush" Value="{StaticResource Info}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Diverged">
          <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Unverifiable">
          <Setter Property="BorderBrush" Value="{StaticResource Bad}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="AutoIncluded">
          <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="New">
          <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="IncomingAhead">
          <Setter Property="Foreground" Value="{StaticResource Info}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Diverged">
          <Setter Property="Foreground" Value="{StaticResource Warn}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="Unverifiable">
          <Setter Property="Foreground" Value="{StaticResource Bad}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TargetStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{StaticResource Warn}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsLinked}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Ok}" />
        </DataTrigger>
        <!-- Phase 9_5-05 — 새 프로젝트를 만들어 연결한다(정상 상태라 경고색이 아니다). -->
        <DataTrigger Binding="{Binding IsCreatingProject}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Info}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Phase 9_2-25 — 펼침 삼각형. 기본 TreeViewItem 템플릿은 삼각형을 머리글 세로 가운데에 두어서, 작업 폴더 상자가 커지면
         삼각형이 따라 내려갔다. 이 템플릿은 삼각형을 머리글 첫 줄(이름 줄) 높이에 고정한다. -->
    <Style x:Key="ImportTreeExpander" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Width="18" Height="18">
              <Path x:Name="Arrow" Data="M 4,3 L 9,7.5 L 4,12 Z" Fill="{StaticResource Muted}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0" />
                </Path.RenderTransform>
              </Path>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Fg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ImportTreeItem" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ToggleButton x:Name="Expander" Style="{StaticResource ImportTreeExpander}" VerticalAlignment="Top" Margin="0,3,0,0"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
              <Border x:Name="Bd" Grid.Column="1" Padding="{TemplateBinding Padding}" CornerRadius="3" Background="Transparent"
                      BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" />
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Info}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ① 상단: ← 목록으로 · 제목 · 백업 한 줄 정보 -->
    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal">
        <Button Content="← 목록으로" Command="{Binding CloseCommand}" Style="{StaticResource SmallButton}" />
        <TextBlock Text="백업 가져오기" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
      <TextBlock Text="{Binding BackupHeaderText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupHeaderText}"
                 Visibility="{Binding BackupHeaderText, Converter={StaticResource NullToCollapsed}}" />
    </StackPanel>

    <!-- ② Codex 실행 배너(편집 중 감지) -->
    <Border Grid.Row="1" Background="{StaticResource WarnBg}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
            Visibility="{Binding HasCodexBanner, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CodexBannerText}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="다시 분석" Command="{Binding ReanalyzeCommand}" Style="{StaticResource SmallButton}" Margin="10,0,0,0" />
      </Grid>
    </Border>

    <!-- ③ 본문(상태별) -->
    <Grid Grid.Row="2" Margin="0,10,0,0">

      <!-- Codex 종료 대기 -->
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="18"
              Visibility="{Binding IsWaitingForCodexExit, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="14" />
          <!-- Phase 9_2-36 — 다시 확인했는데 아직 실행 중이면 확인 시각을 보여준다. -->
          <TextBlock Text="{Binding CodexRecheckText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                     AutomationProperties.LiveSetting="Polite"
                     Visibility="{Binding CodexRecheckText, Converter={StaticResource NullToCollapsed}}" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Center">
            <Button Content="다시 확인" Command="{Binding RecheckCodexCommand}" />
            <Button Content="닫기" Command="{Binding CloseCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 분석 중 -->
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="18"
              Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" />
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Foreground="{StaticResource Info}"
                       Background="{StaticResource PanelAlt}" BorderThickness="0" />
          <Button Content="취소" Command="{Binding CancelAnalysisCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>
      </Border>

      <!-- 분석 실패 -->
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="18"
              Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" FontSize="14" />
          <TextBlock Text="{Binding MessageHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Center">
            <!-- Phase 9_2-37 — 다시 시도하면 될 수 있는 실패에서만 보인다(우측 상단 [다시 분석]과 같은 명령). -->
            <Button Content="다시 분석" Command="{Binding ReanalyzeCommand}"
                    Visibility="{Binding CanRetryAnalysis, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="다른 파일 선택" Command="{Binding ChooseOtherFileCommand}" />
            <Button Content="닫기" Command="{Binding CloseCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 편집: 트리 | 상세 -->
      <Grid Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" MinWidth="300" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="2*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 검색 + 빠른 선택 -->
            <WrapPanel>
              <TextBox Width="240" Margin="0,0,8,4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       Style="{StaticResource SearchBox}" Tag="대화 제목 또는 프로젝트 이름 검색"
                       ToolTip="대화 제목이나 프로젝트 이름으로 찾기(선택은 그대로 유지됩니다)" AutomationProperties.Name="대화 또는 프로젝트 검색" />
              <Button Content="새 대화만" Command="{Binding SelectNewOnlyCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,4" />
              <Button Content="전체 선택" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,4" />
              <Button Content="모두 해제" Command="{Binding ClearAllCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,4" />
            </WrapPanel>

            <TreeView x:Name="ImportTree" Grid.Row="1" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding Projects}" SelectedItemChanged="ImportTree_SelectedItemChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource ImportTreeItem}">
                  <Setter Property="IsSelected" Value="{Binding IsTreeSelected, Mode=TwoWay}" />
                  <!-- Phase 9_2-23 — UI 자동화·화면 읽기 프로그램이 클래스 이름 대신 표시 이름을 읽는다. -->
                  <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                  <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                  <Setter Property="views:TreeViewItemBehavior.BringIntoViewWhenSelected" Value="True" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Conversations}">
                  <!-- TreeViewItem 머리글은 폭 제한이 없어 줄바꿈이 안 된다 → TreeView 폭에서 들여쓰기만큼 뺀 폭을 준다. -->
                  <StackPanel Margin="0,2,0,4"
                              Width="{Binding ActualWidth, ElementName=ImportTree, Converter={StaticResource Subtract}, ConverterParameter=44}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}" Focusable="True"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                AutomationProperties.Name="{Binding DisplayName}"
                                IsEnabled="{Binding DataContext.CanEditSelection, ElementName=Root}"
                                Visibility="{Binding HasCheckbox, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="8,0,0,0" />
                    </Grid>

                    <!-- 작업 폴더 영역(설계 §7.3). 조상 그룹에는 설명 한 줄만. -->
                    <Border Background="{StaticResource PanelAlt}" CornerRadius="5" Padding="10,7" Margin="22,6,0,2">
                      <StackPanel>
                        <TextBlock Text="작업 폴더" Style="{StaticResource Caption}"
                                   Visibility="{Binding IsFolderEditable, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,3,0,0" Visibility="{Binding IsFolderEditable, Converter={StaticResource BoolToVisibility}}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Text="원본" Style="{StaticResource Caption}" />
                          <TextBlock Grid.Column="1" Text="{Binding OriginalPathText}" Style="{StaticResource PathText}" Foreground="{StaticResource Muted}" ToolTip="{Binding OriginalPathRaw}" />
                          <TextBlock Grid.Row="1" Text="이 PC" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocalPathText}" Style="{StaticResource PathText}" Margin="0,2,0,0" ToolTip="{Binding LocalPathRaw}" />
                        </Grid>
                        <TextBlock Text="{Binding TargetStatusText}" Style="{StaticResource TargetStatusText}" Margin="0,5,0,0" />
                        <!-- Phase 9_5-05 — 새 프로젝트 이름(기본값 폴더 이름). 빈 이름이면 아래 오류 줄이 보이고 가져오기가 꺼진다. -->
                        <Grid Margin="0,5,0,0" Visibility="{Binding IsCreatingProject, Converter={StaticResource BoolToVisibility}}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="새 프로젝트 이름" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                          <TextBox Grid.Column="1" Text="{Binding NewProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="새 프로젝트 이름"
                                   IsEnabled="{Binding DataContext.CanEditSelection, ElementName=Root}" />
                        </Grid>
                        <CheckBox Content="새 프로젝트를 만들지 않고 기타 대화로 가져오기" IsChecked="{Binding DeclineCreation, Mode=TwoWay}"
                                  FontSize="11" Margin="0,5,0,0"
                                  IsEnabled="{Binding DataContext.CanEditSelection, ElementName=Root}"
                                  Visibility="{Binding IsCreationOffered, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding DecisionError}" Foreground="{StaticResource Bad}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding DecisionError, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding FolderCreateError}" Foreground="{StaticResource Bad}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding FolderCreateError, Converter={StaticResource NullToCollapsed}}" />
                        <WrapPanel Margin="0,6,0,0" Visibility="{Binding IsFolderEditable, Converter={StaticResource BoolToVisibility}}">
                          <Button Content="{Binding ChooseFolderText}" Command="{Binding ChooseFolderCommand}" Style="{StaticResource SmallButton}" />
                          <!-- Phase 9_5-07 — 아래 "새 폴더 위치"에 이 프로젝트 이름으로 빈 폴더를 만들고 바로 작업 폴더로 지정한다. -->
                          <Button Content="새 폴더 만들기" Command="{Binding CreateFolderCommand}" Style="{StaticResource SmallButton}"
                                  ToolTip="새 폴더 위치에 이 이름으로 빈 폴더를 만들고 작업 폴더로 지정합니다."
                                  Visibility="{Binding ShowCreateFolder, Converter={StaticResource BoolToVisibility}}" />
                          <Button Content="원래대로" Command="{Binding ResetFolderCommand}" Style="{StaticResource SmallButton}"
                                  Visibility="{Binding IsFolderUserSelected, Converter={StaticResource BoolToVisibility}}" />
                          <Button Content="새로고침" Command="{Binding DataContext.ReanalyzeCommand, ElementName=Root}" Style="{StaticResource SmallButton}"
                                  ToolTip="Codex에서 폴더를 연 뒤 누르면 다시 분석합니다(선택은 유지됩니다)."
                                  Visibility="{Binding ShowRefreshHint, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <HierarchicalDataTemplate.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,1"
                            Width="{Binding ActualWidth, ElementName=ImportTree, Converter={StaticResource Subtract}, ConverterParameter=64}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsAutoIncluded}" Value="True">
                                <Setter Property="Opacity" Value="0.6" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsCheckable}"
                                  VerticalAlignment="Center" Margin="0,0,6,0"
                                  AutomationProperties.Name="{Binding Title}"
                                  ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DisabledReason}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                          <!-- Phase 9_2-26 — 이미 이 PC에 있는 대화는 행 안에서 바로 어디 있는지 보인다. -->
                          <TextBlock Text="{Binding RowLocationText}" Style="{StaticResource Caption}" FontSize="10"
                                     TextTrimming="CharacterEllipsis" ToolTip="{Binding RowLocationText}"
                                     Visibility="{Binding RowLocationText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource BadgeBorder}" VerticalAlignment="Center"
                                ToolTip="{Binding DisabledReason}">
                          <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeText}" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>

            <!-- Phase 9_5-08 — [새 폴더 만들기]가 폴더를 만드는 곳. [변경…]은 폴더 선택 대화상자이고 고르면 설정에 저장한다. -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding CanCreateFolders, Converter={StaticResource BoolToVisibility}}">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="변경…" Command="{Binding ChangeNewFolderBaseCommand}" Style="{StaticResource SmallButton}"
                        AutomationProperties.Name="새 폴더 위치 변경" />
                <TextBlock Text="{Binding NewFolderBaseText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding NewFolderBase}" />
              </DockPanel>
              <TextBlock Text="{Binding NewFolderBaseError}" Foreground="{StaticResource Warn}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                         Visibility="{Binding NewFolderBaseError, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Margin="4,0" Cursor="SizeWE" />

        <!-- 오른쪽 상세 -->
        <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="6" Padding="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="왼쪽에서 대화나 프로젝트를 선택하세요." Style="{StaticResource Caption}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />

              <!-- 대화 상세: 위 정보 + 아래 대화 내용(메인 Viewer와 같은 모양, 가상화 목록) -->
              <Grid Visibility="{Binding SelectedConversation, Converter={StaticResource NullToCollapsed}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                  <StackPanel DataContext="{Binding SelectedConversation}">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left" Margin="0,6,0,0">
                      <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeText}" />
                    </Border>
                    <TextBlock Text="{Binding StatusSentence}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
                    <TextBlock Text="{Binding PresenceText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                               Visibility="{Binding PresenceText, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="원본 작업 폴더" Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Visibility="{Binding OriginalCwd, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding OriginalCwdText}" Style="{StaticResource PathText}" ToolTip="{Binding OriginalCwd}"
                               Visibility="{Binding OriginalCwd, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding DatesText}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding DatesText, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding LimitationText}" Foreground="{StaticResource Warn}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding LimitationText, Converter={StaticResource NullToCollapsed}}" />
                  </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <StackPanel>
                    <TextBlock Text="대화 내용(백업 안의 기록, 읽기 전용)" Style="{StaticResource Caption}" />
                    <TextBlock Text="읽는 중…" Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding IsContentLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ContentNotice}" Foreground="{StaticResource Warn}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ContentNotice, Converter={StaticResource NullToCollapsed}}" />
                  </StackPanel>
                  <!-- 메인 Viewer와 같은 공용 모양(App.xaml) + 가상화 + 픽셀 스크롤. -->
                  <ListBox x:Name="ContentList" Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding ContentMessages}"
                           ItemContainerStyle="{StaticResource ConversationMessageItemStyle}"
                           ItemTemplate="{StaticResource ConversationMessageTemplate}"
                           AutomationProperties.Name="대화 내용"
                           BorderThickness="0" Background="Transparent"
                           ScrollViewer.CanContentScroll="True"
                           VirtualizingPanel.IsVirtualizing="True"
                           VirtualizingPanel.VirtualizationMode="Recycling"
                           VirtualizingPanel.ScrollUnit="Pixel"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
              </Grid>

              <!-- 프로젝트 상세 -->
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding SelectedProject, Converter={StaticResource NullToCollapsed}}">
                <StackPanel DataContext="{Binding SelectedProject}">
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DetailSummaryText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" />
                  <TextBlock Text="{Binding TargetStatusText}" Style="{StaticResource TargetStatusText}" Margin="0,8,0,0" />
                  <TextBlock Text="원본 경로" Style="{StaticResource Caption}" Margin="0,10,0,0"
                             Visibility="{Binding IsFolderEditable, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="{Binding OriginalPathText}" Style="{StaticResource PathText}" ToolTip="{Binding OriginalPathRaw}"
                             Visibility="{Binding IsFolderEditable, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="이 PC 경로" Style="{StaticResource Caption}" Margin="0,6,0,0"
                             Visibility="{Binding IsFolderEditable, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="{Binding LocalPathText}" Style="{StaticResource PathText}" ToolTip="{Binding LocalPathRaw}"
                             Visibility="{Binding IsFolderEditable, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <!-- 상세 정보 ▼ (개발/문제 분석용) -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
              <ToggleButton x:Name="BackupDetailToggle" Style="{StaticResource DetailToggleLink}" HorizontalAlignment="Left" />
              <ItemsControl ItemsSource="{Binding DetailRows}" Margin="0,6,0,0" MaxHeight="180"
                            Visibility="{Binding IsChecked, ElementName=BackupDetailToggle, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource PathText}" Foreground="{StaticResource Muted}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- 적용 중 -->
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="18"
              Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
          <TextBlock Text="적용하는 중입니다. Codex를 실행하지 마세요." FontSize="14" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ApplyStatusText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Foreground="{StaticResource Info}"
                       Background="{StaticResource PanelAlt}" BorderThickness="0" />
          <Button Content="적용 취소" Command="{Binding CancelApplyCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>
      </Border>

      <!-- 결과(ImportResultViewModel) -->
      <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="18"
              Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}">
        <Grid DataContext="{Binding Result}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{StaticResource Warn}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Fg}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding CountsText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Visibility="{Binding CountsText, Converter={StaticResource NullToCollapsed}}" />
          </StackPanel>

          <ListBox Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Groups}" BorderThickness="0" Background="Transparent"
                   AutomationProperties.Name="가져오기 결과" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Destination}" Style="{StaticResource Caption}" Margin="8,1,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Destination, Converter={StaticResource NullToCollapsed}}" />
                  </WrapPanel>
                  <ListBox ItemsSource="{Binding Items}" Margin="16,4,0,0" BorderThickness="0" Background="Transparent"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <ContentPresenter />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,1">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Caption}" Margin="10,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <!-- Phase 9_2-29b — 복구 지점은 날짜·시각으로 짧게, 전체 ID는 툴팁. -->
            <TextBlock Text="{Binding SnapshotText}" Style="{StaticResource Caption}" ToolTip="{Binding SnapshotId}"
                       Visibility="{Binding SnapshotText, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                        DataContext="{Binding DataContext, ElementName=Root}">
              <Button Content="목록에서 보기" Command="{Binding ShowInListCommand}" />
              <Button Content="다시 시도" Command="{Binding RetryCommand}"
                      Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
              <Button Content="닫기" Command="{Binding CloseCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ④ 하단 요약 + [대화 N개 가져오기] -->
    <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="6" Padding="12,9" Margin="0,10,0,0"
            Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SummaryHint}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                     Visibility="{Binding SummaryHint, Converter={StaticResource NullToCollapsed}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSummaryHintWarning}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding EditingError}" Foreground="{StaticResource Bad}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                     Visibility="{Binding EditingError, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding ImportButtonText}" Command="{Binding ImportCommand}"
                VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
