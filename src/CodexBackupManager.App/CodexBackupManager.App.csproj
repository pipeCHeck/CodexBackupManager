<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CodexBackupManager.App</RootNamespace>
    <AssemblyName>CodexBackupManager</AssemblyName>

    <!--
      개발 중 dotnet build/run은 framework-dependent(SelfContained=false)로 빠르게 빌드한다.
      이 상태로 배포하면 대상 PC에 .NET 10 Desktop 런타임이 설치되어 있어야 한다.

      CLAUDE.md §38이 확정한 최종 배포 형태(런타임 설치 불필요한 단일 exe)는
      publish 시점에만 self&#45;contained 옵션을 켜서 만든다. 정확한 명령은
      README "빌드 · 테스트 · 실행" 참고.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>

    <!--
      Phase 8 — v0.1.0 배포 형태 확정(WPF이므로 trimming은 절대 켜지 않는다).
      실제 self-contained/single-file publish는 여전히 publish 시점에만
      `-p:SelfContained=true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true`
      로 켠다(scripts/publish-release.ps1 참고) — 위 개발용 SelfContained=false는 그대로 유지해
      dotnet build/run의 내부 루프 속도를 지킨다.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- WPF XAML 코드 생성 때문에 XML 문서 경고를 프로젝트 단위로 완화한다. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\CodexBackupManager.Codex\CodexBackupManager.Codex.csproj" />
    <ProjectReference Include="..\CodexBackupManager.Domain\CodexBackupManager.Domain.csproj" />
    <ProjectReference Include="..\CodexBackupManager.Backup\CodexBackupManager.Backup.csproj" />
    <ProjectReference Include="..\CodexBackupManager.Restore\CodexBackupManager.Restore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MainViewModel의 내부 ConversationSelectionState에 테스트가 직접 접근해 Changed 이벤트
         발생 횟수를 셀 수 있게 한다(공개 API는 늘리지 않는다). -->
    <InternalsVisibleTo Include="CodexBackupManager.App.Tests" />
  </ItemGroup>

</Project>
