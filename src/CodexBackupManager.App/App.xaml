<Application x:Class="CodexBackupManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- ── 색상 토큰 ──────────────────────────────────────────────────────
         UI/UX 개선(다크 테마 대비 정리) 작업에서 뽑아낸 재사용 가능한 팔레트.
         버튼 기본 스타일이 배경/전경을 명시하지 않아 시스템 기본(밝은 배경 + 검은 글씨에
         가까움) 테마를 그대로 물려받던 것이 "흰 배경/흰 글씨처럼 보임" 문제의 원인이었다. -->
    <SolidColorBrush x:Key="Bg" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="Panel" Color="#FF2B2D31" />
    <!-- Panel과 구분되는 살짝 밝은 패널. Assistant 말풍선/코드블록 등에 쓴다. -->
    <SolidColorBrush x:Key="PanelAlt" Color="#FF33363B" />
    <SolidColorBrush x:Key="Fg" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Muted" Color="#FF9AA0A6" />
    <SolidColorBrush x:Key="Ok" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="Bad" Color="#FFE57373" />
    <SolidColorBrush x:Key="Warn" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="Border" Color="#FF44474D" />
    <SolidColorBrush x:Key="CodeBg" Color="#FF17181B" />
    <SolidColorBrush x:Key="UserBubbleBg" Color="#FF2F3B4C" />

    <SolidColorBrush x:Key="ButtonBg" Color="#FF3A3D42" />
    <SolidColorBrush x:Key="ButtonBgHover" Color="#FF484B52" />
    <SolidColorBrush x:Key="ButtonBgPressed" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="ButtonFg" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#FF55585F" />
    <SolidColorBrush x:Key="ButtonBgDisabled" Color="#FF2A2C30" />
    <SolidColorBrush x:Key="ButtonFgDisabled" Color="#FF7C7F85" />
    <SolidColorBrush x:Key="ButtonBorderDisabled" Color="#FF3A3D42" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- 버튼은 시스템 기본 크롬(밝은 배경)에 전혀 의존하지 않도록 배경/전경/테두리를 전부
         직접 그린다. Hover/Pressed/Disabled 모두 명시적으로 대비를 확보한다 —
         특히 Disabled는 "비활성처럼 보이되 글자는 읽을 수 있게" 한다. -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
      <Setter Property="Background" Value="{StaticResource ButtonBg}" />
      <Setter Property="Foreground" Value="{StaticResource ButtonFg}" />
      <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                 TextElement.Foreground="{TemplateBinding Foreground}"
                                 RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonBgHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonBgPressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonBgDisabled}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ButtonBorderDisabled}" />
                <Setter Property="Foreground" Value="{StaticResource ButtonFgDisabled}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox는 네이티브 글리프를 유지하되(과설계 방지), 라벨 글자색만 명시해
         테마와 무관하게 항상 또렷이 보이게 한다. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}" />
      <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ── 다크 테마 ScrollBar ────────────────────────────────────────────
         WPF 기본 ScrollBar(밝은 회색 화살표/트랙)가 다크 테마와 어울리지 않는다는 지적을
         반영. 위/아래 화살표 버튼은 Opacity=0으로 안 보이게 하되(클릭 시 페이지 단위 스크롤은
         그대로 동작), Track은 투명, Thumb만 얇게 보여준다. TargetType 전용(x:Key 없는) 암시적
         스타일이라 이 대화 Viewer의 ListBox뿐 아니라 앱의 다른 모든 ScrollViewer/ScrollBar에도
         자동 재사용된다 — ScrollUnit=Pixel, VirtualizationMode=Recycling 등 스크롤 동작 자체는
         전혀 건드리지 않는다(순수 ControlTemplate 교체). -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF5A5D63" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF6E7178" />
    <SolidColorBrush x:Key="ScrollThumbPressed" Color="#FF84878E" />

    <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
      <Setter Property="Background" Value="{StaticResource ScrollThumb}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2,1" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource ScrollThumbHover}" />
        </Trigger>
        <Trigger Property="IsDragging" Value="True">
          <Setter Property="Background" Value="{StaticResource ScrollThumbPressed}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="9" />
      <Setter Property="MinWidth" Value="9" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource DarkScrollBarThumb}" />
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="9" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="MinHeight" Value="9" />
        </Trigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>
