<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CodexBackupManager.Codex</RootNamespace>
    <AssemblyName>CodexBackupManager.Codex</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexBackupManager.Domain\CodexBackupManager.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 내부 헬퍼(TOML 스칼라 파서, SQLite URI 빌더)를 단위 테스트에서 직접 검증한다. -->
    <InternalsVisibleTo Include="CodexBackupManager.Codex.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Codex의 state_*.sqlite를 읽기 전용으로 열기 위한 유일한 외부 패키지.
      버전은 2026-09-11 dotnet restore에서 실제로 해석된 값으로 고정했다.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
