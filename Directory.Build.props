<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!--
      ImplicitUsings를 끈다. 어떤 타입이 어디서 왔는지 파일 상단에서 바로 보이게 하기 위함.
      Codex 데이터 구조를 다루는 코드에서는 이 명시성이 유지보수에 유리하다.
    -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- 기본 분석기 수준을 사용한다. 코드 스타일 규칙은 빌드를 막지 않는다. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Product>Codex Backup Manager</Product>
    <Company>codex-backup-manager</Company>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <!--
    Phase 8 — 실제 "Release publish"(scripts/publish-release.ps1, CI의 publish-artifact job)
    에서만 PDB를 만들지 않는다. 평범한 `dotnet build -c Release`/`dotnet test -c Release`(CI의
    build-and-test job 포함)는 그대로 심볼을 유지해 디버깅/테스트 실패 스택 추적에 지장이 없다.

    `SelfContained=true`/`PublishSingleFile=true` 같은 RID 전용 속성은 outer(App) 프로젝트에만
    적용되고 ProjectReference로 참조되는 class library(Domain/Codex/Backup/Restore)에는 전파되지
    않는다(MSBuild가 cross-targeting을 위해 의도적으로 걸러낸다) — 그래서 그 속성으로는 조건을 걸
    수 없다. 대신 이 프로젝트 전용 커스텀 속성(`CbmReleasePublish`)을 publish 명령에서 명시적으로
    넘기고, 그 값으로 조건을 건다 — 커스텀 속성은 일반 global property라 전체 빌드(참조 프로젝트
    포함)에 그대로 전파된다.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' AND '$(CbmReleasePublish)'=='true'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
