<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!--
      ImplicitUsings를 끈다. 어떤 타입이 어디서 왔는지 파일 상단에서 바로 보이게 하기 위함.
      Codex 데이터 구조를 다루는 코드에서는 이 명시성이 유지보수에 유리하다.
    -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- 기본 분석기 수준을 사용한다. 코드 스타일 규칙은 빌드를 막지 않는다. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>ko-KR</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Product>Codex Backup Manager</Product>
    <Company>codex-backup-manager</Company>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
